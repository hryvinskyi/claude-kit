#!/bin/sh
# board-queue-mcp — the queue's MCP server over standard input and output; see
# board-queue-mcp.ts beside it. Its board reads use the optional App credential.
# Its own directory, through any links that lead here.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case "$LINK" in /*) SELF=$LINK ;; *) SELF=$(dirname "$SELF")/$LINK ;; esac
done
HERE=$(cd "$(dirname "$SELF")" && pwd)
. "$HERE/../lib/launch.sh"
board_queue_require_dependencies "$HERE/.." "$HOME/.local/bin/board-queue-mcp" "$@"
board_queue_load_credentials
exec node "$HERE/board-queue-mcp.ts" "$@"

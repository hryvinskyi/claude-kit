#!/bin/sh
# pipeline-decide status|questions|size|rules|done — ask a decision model about a change; see decide.py beside it.
# Its own directory, through any links that lead here.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case "$LINK" in /*) SELF=$LINK ;; *) SELF=$(dirname "$SELF")/$LINK ;; esac
done
HERE=$(cd "$(dirname "$SELF")" && pwd)
exec python3 "$HERE/decide.py" "$@"

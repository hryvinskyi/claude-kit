#!/bin/sh
# pipeline-progress phase|task|set-aside|resume — where a /pipeline:feature run stands, kept beside its plan; see progress.py beside it.
# Its own directory, through any links that lead here.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case "$LINK" in /*) SELF=$LINK ;; *) SELF=$(dirname "$SELF")/$LINK ;; esac
done
HERE=$(cd "$(dirname "$SELF")" && pwd)
exec python3 "$HERE/progress.py" "$@"

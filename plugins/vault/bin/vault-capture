#!/bin/sh
# vault-capture [--update | --brief | --outcome | --worker F | --help] — the session-end capture, or run by hand with
# nothing on stdin for what it does that needs no session; see session_capture.py beside it.
# Its own directory, through any links that lead here.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case "$LINK" in /*) SELF=$LINK ;; *) SELF=$(dirname "$SELF")/$LINK ;; esac
done
HERE=$(cd "$(dirname "$SELF")" && pwd)
exec python3 "$HERE/session_capture.py" "$@"
